{
  "Titlebar": {
    "_include": "vbox.json::Box",
    "attributes": {
      "Corner Radii.Top Left": 3,
      "Corner Radii.Top Right": 3,
      "Fill": "#00000000"
    },
    "children": {
      "Exit Button": {
        "_include": "titlebarbutton.json::Titlebar Button",
        "children": {
          "Graphic": {
            "children": {
              "Svg": {
                "attributes": {
                  "Color": {
                    "states": {
                      "Selected": "#e33034"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "Maximize Button": "titlebarbutton.json::Titlebar Button",
      "Minimize Button": "titlebarbutton.json::Titlebar Button",
      "Settings Button": "titlebarbutton.json::Titlebar Button",
      "Tab Bar": "vtabbar.json::Tab Bar"
    }
  }
}