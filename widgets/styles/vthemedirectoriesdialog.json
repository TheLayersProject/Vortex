{
    "Theme Directories Dialog": {
        "_include": "vdialog.json::Dialog",
        "children": {
            "Directory Label": {
                "_include": "vlabel.json::Label",
                "attributes": {
                    "Corner Radii.Bottom Left": 3,
                    "Corner Radii.Bottom Right": 3,
                    "Corner Radii.Top Left": 3,
                    "Corner Radii.Top Right": 3,
                    "Fill": "L:Theme/Secondary"
                }
            },
            "New Directory Button": {
                "_include": "vbox.json::Box",
                "attributes": {
                    "Corner Radii.Bottom Left": 3,
                    "Corner Radii.Bottom Right": 3,
                    "Corner Radii.Top Left": 3,
                    "Corner Radii.Top Right": 3,
                    "Fill": "L:Theme/Tertiary"
                },
                "children": {
                    "Graphic": {
                        "children": {
                            "Svg": {
                                "attributes": {
                                    "Color": "L:Theme/Foreground"
                                }
                            }
                        }
                    },
                    "Text Label": "vlabel.json::Label"
                }
            }
        }
    }
}