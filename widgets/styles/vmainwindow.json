{
    "Main Window": {
        "_include": "vbox.json::Box",
        "attributes": {
            "Border.Fill": "L:Theme/Gradient",
            "Border.Thickness": 8,
            "Corner Radii.Bottom Left": 12,
            "Corner Radii.Bottom Right": 12,
            "Corner Radii.Top Left": 12,
            "Corner Radii.Top Right": 12
        },
        "children": {
            "Separator": {
                "_include": "vbox.json::Box",
                "attributes": {
                    "Fill": "L:Theme/Tertiary"
                }
            },
            "Titlebar": "titlebar.json::Titlebar"
        }
    }
}
