{
    "Main Window/Settings Menu/Appearance Widget": {
        "_include": "QLayers/qlwidget.json::Widget",
        "children": {
            "Dividers": {
                "_include": "QLayers/qlwidget.json::Widget",
                "attributes": {
                    "Fill": "L:Theme/Tertiary"
                }
            },
            "Styles Widget": {
                "_include": "QLayers/qlwidget.json::Widget",
                "children": {
                    "Options Bar": {
                        "_include": "QLayers/qlwidget.json::Widget",
                        "attributes": {
                            "Fill": "L:Theme/Tertiary"
                        }
                    },
                    "Style Scroller": {
                        "children": {
                            "Style Scroller Widget": {
                                "_include": "QLayers/qlwidget.json::Widget",
                                "children": {
                                    "Check Box": "QLayers/qlcheckbox.json::Check Box",
                                    "Style Button": {
                                        "_include": "QLayers/qlwidget.json::Widget",
                                        "attributes": {
                                            "Border.Fill": "L:Theme/Tertiary",
                                            "Border.Thickness": 2,
                                            "Corner Radii.Bottom Left": 5,
                                            "Corner Radii.Bottom Right": 5,
                                            "Corner Radii.Top Left": 5,
                                            "Corner Radii.Top Right": 5
                                        },
                                        "children": {
                                            "Name Label": "QLayers/qllabel.json::Label",
                                            "Publisher Label": "QLayers/qllabel.json::Label"
                                        }
                                    }
                                }
                            },
                            "Vertical ScrollBar": "QLayers/qlscrollbar.json::Scroll Bar"
                        }
                    }
                }
            },
            "Tab Bar": "Vortex/vtabbar.json::Tab Bar",
            "Theme Widget": {
                "_include": "QLayers/qlwidget.json::Widget",
                "children": {
                    "Options Bar": {
                        "_include": "QLayers/qlwidget.json::Widget",
                        "attributes": {
                            "Fill": "L:Theme/Tertiary"
                        },
                        "children": {
                            "Active Theme Displayer": {
                                "_include": "QLayers/qlwidget.json::Widget",
                                "attributes": {
                                    "Corner Radii.Bottom Left": 3,
                                    "Corner Radii.Bottom Right": 3,
                                    "Corner Radii.Top Left": 3,
                                    "Corner Radii.Top Right": 3
                                },
                                "children": {
                                    "Theme Label": "QLayers/qllabel.json::Label",
                                    "Publisher Label": "QLayers/qllabel.json::Label"
                                }
                            },
                            "Theme Directories Button": {
                                "_include": "QLayers/qlwidget.json::Widget",
                                "attributes": {
                                    "Corner Radii.Bottom Left": 3,
                                    "Corner Radii.Bottom Right": 3,
                                    "Corner Radii.Top Left": 3,
                                    "Corner Radii.Top Right": 3
                                }
                            }
                        }
                    },
                    "Theme Scroller": {
                        "children": {
                            "Vertical ScrollBar": "QLayers/qlscrollbar.json::Scroll Bar"
                        }
                    }
                }
            },
            "Theme Combobox": {
                "attributes": {
                    "Border.Fill": "#000000",
                    "Border.Thickness": 0,
                    "Corner Radius": 5,
                    "Fill": "L:Theme/Tertiary",
                    "Text Color": "L:Theme/Foreground"
                },
                "children": {
                    "Items": {
                        "attributes": {
                            "Corner Radius": 5,
                            "Fill": {
                                "states": {
                                    "Selected": "#34486C"
                                },
                                "value": "#13171F"
                            },
                            "Text Color": {
                                "link_relative": "L:../Text Color"
                            }
                        }
                    }
                }
            },
            "Theme Label": "QLayers/qllabel.json::Label"
        }
    }
}