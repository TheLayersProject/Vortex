{
    "Tab Bar": {
        "_include": "QLayers/qlwidget.json::Widget",
        "attributes": {
            "Corner Radii.Top Left": 3,
            "Corner Radii.Top Right": 3
        },
        "children": {
            "Tabs": {
                "_include": "QLayers/qlwidget.json::Widget",
                "attributes": {
                    "Corner Radii.Top Left": 3,
                    "Corner Radii.Top Right": 3,
                    "Fill": {
                        "states": {
                            "Active": "L:Theme/Tertiary"
                        }
                    }
                },
                "children": {
                    "Close Button": {
                        "_include": "QLayers/qlwidget.json::Widget",
                        "attributes": {
                            "Fill": "#00ffffff"
                        },
                        "children": {
                            "Graphic": {
                                "children": {
                                    "Svg": {
                                        "attributes": {
                                            "Color": {
                                                "states": {
                                                    "Selected": "#e95454"
                                                },
                                                "value": "#5f5f5f"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "Icon": {
                        "children": {
                            "Svg": {
                                "attributes": {
                                    "Color": "L:Theme/Foreground"
                                }
                            }
                        }
                    },
                    "Text Label": "QLayers/qllabel.json::Label"
                }
            }
        }
    }
}
